{
  "description": "MasterGraph zero-cost UserPromptSubmit relay for ChatGPT Work/Codex. Ordinary Chat does not execute this hook.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mastergraph_user_prompt_submit.py\"",
            "timeout": 15,
            "statusMessage": "Relaying prompt to MasterGraph"
          }
        ]
      }
    ]
  }
}
